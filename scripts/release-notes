#!/usr/bin/env python3
"""Print one version's entry from CHANGELOG.md, as the notes of its GitHub release.

The entry is the text under the `##` heading that names the version, up to the next `##`
heading. The heading itself is left out, because the release's title names the version. A
version no heading names, or one two headings name, is refused, because the notes would then
be empty or a guess, and a release's notes are what a person reads before installing it.

A heading names a version the way `scripts/check-release` reads one: a dotted numeric run of
three components in a line beginning `#`.

Usage:
  scripts/release-notes X.Y.Z               the entry for X.Y.Z in this repository's changelog
  scripts/release-notes --changelog F X.Y.Z the entry in F
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ENTRY = re.compile(r"##\s")
VERSION = re.compile(r"(?<![\d.])(\d+\.\d+\.\d+)(?![\d.])")


def entry(text: str, version: str) -> str:
    lines = text.splitlines()
    starts = [
        index
        for index, line in enumerate(lines)
        if ENTRY.match(line) and version in VERSION.findall(line)
    ]
    if not starts:
        raise SystemExit(f"release-notes: no CHANGELOG.md heading names {version}")
    if len(starts) > 1:
        raise SystemExit(f"release-notes: {len(starts)} CHANGELOG.md headings name {version}")
    body = []
    for line in lines[starts[0] + 1 :]:
        if ENTRY.match(line) or re.match(r"#\s", line):
            break
        body.append(line)
    notes = "\n".join(body).strip("\n")
    if not notes.strip():
        raise SystemExit(f"release-notes: the CHANGELOG.md entry for {version} is empty")
    return notes + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description="print one version's changelog entry")
    parser.add_argument("--changelog", type=Path, default=ROOT / "CHANGELOG.md")
    parser.add_argument("version")
    arguments = parser.parse_args()
    if not re.fullmatch(r"\d+\.\d+\.\d+", arguments.version):
        parser.error(f"{arguments.version!r} is not a version; give three numbers, as in 0.33.0")
    sys.stdout.write(entry(arguments.changelog.read_text(encoding="utf-8"), arguments.version))
    return 0


if __name__ == "__main__":
    sys.exit(main())
