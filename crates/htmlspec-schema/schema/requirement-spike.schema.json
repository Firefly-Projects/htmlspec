{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://html-spec.dev/schema/spike/requirement.schema.json",
  "title": "RequirementSpike",
  "description": "Minimal projected-model schema covering only the requirement unit. Spike input for task 1.3; not the contract.",
  "type": "object",
  "required": ["unit", "id", "title", "statements", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "unit": { "const": "requirement" },
    "id": { "type": "string", "pattern": "^req-[a-z0-9-]+$" },
    "change": { "enum": ["added", "modified", "removed", "unchanged"], "default": "unchanged" },
    "title": { "type": "string", "minLength": 1 },
    "statements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scenario" }
    }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "required": ["unit", "id", "title", "when", "then"],
      "additionalProperties": false,
      "properties": {
        "unit": { "const": "scenario" },
        "id": { "type": "string", "pattern": "^scenario-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "given": { "type": "array", "items": { "type": "string" } },
        "when": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "then": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
