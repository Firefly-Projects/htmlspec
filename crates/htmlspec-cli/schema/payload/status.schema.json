{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://html-spec.dev/schema/payload/1/status.schema.json",
  "title": "htmlspec status --json",
  "description": "The payload `htmlspec status --json` (`get status`) writes: which of a change's artifacts exist, and how much of its work is done. A later 1.x release can add a property to any object in this payload, and only a major release removes, renames, or retypes one, so a consumer ignores a property it does not know.",
  "type": "object",
  "required": [
    "change",
    "artifacts",
    "tasks"
  ],
  "properties": {
    "change": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "present"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "present": {
            "type": "boolean"
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "required": [
        "total",
        "open",
        "openTasks",
        "doneDifferently",
        "doneDifferentlyTasks"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        },
        "openTasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "doneDifferently": {
          "type": "integer",
          "minimum": 0
        },
        "doneDifferentlyTasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
