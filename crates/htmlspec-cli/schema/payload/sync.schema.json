{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://html-spec.dev/schema/payload/1/sync.schema.json",
  "title": "htmlspec sync --json",
  "description": "The payload `htmlspec sync --json` (`get sync`) writes: which of a change's requirements reached the accepted specifications, and which parts of its contract did not. A later 1.x release can add a property to any object in this payload, and only a major release removes, renames, or retypes one, so a consumer ignores a property it does not know.",
  "type": "object",
  "required": [
    "change",
    "stated",
    "reached",
    "absent",
    "untakenRenames",
    "untakenContent",
    "untakenRemovals"
  ],
  "properties": {
    "change": {
      "type": [
        "string",
        "null"
      ]
    },
    "stated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reached": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "absent": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "untakenRenames": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/untakenRename"
      }
    },
    "untakenContent": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/untakenContent"
      }
    },
    "untakenRemovals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "untakenRename": {
      "description": "A rename the accepted specifications have not taken. acceptedHeading is null where the accepted requirement has no heading.",
      "type": "object",
      "required": [
        "id",
        "heading",
        "acceptedHeading"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "acceptedHeading": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "untakenContent": {
      "description": "A requirement whose content the accepted specifications do not hold, naming where the two differ and never what either says.",
      "type": "object",
      "required": [
        "id",
        "firstDifferingStatement",
        "scenariosNotHeld",
        "scenariosNotKept"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "firstDifferingStatement": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "scenariosNotHeld": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenariosNotKept": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
