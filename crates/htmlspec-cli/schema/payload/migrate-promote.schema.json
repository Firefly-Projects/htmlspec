{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://html-spec.dev/schema/payload/1/migrate-promote.schema.json",
  "title": "htmlspec migrate promote --json",
  "description": "The payload `htmlspec migrate promote --json` (`post promotion`) writes: the coverage gate's findings, the staged project's faults and diagnostics, and what was moved. A later 1.x release can add a property to any object in this payload, and only a major release removes, renames, or retypes one, so a consumer ignores a property it does not know.",
  "type": "object",
  "required": [
    "plan",
    "survey",
    "staged",
    "surveyed",
    "planned",
    "promoted",
    "moved",
    "clear",
    "covered",
    "unaccounted",
    "withoutDisposition",
    "unknownDisposition",
    "withoutReason",
    "duplicated",
    "unsurveyed",
    "sourceless",
    "withoutDestination",
    "unreadableDerivations",
    "collisions",
    "stagingFaults",
    "documents",
    "diagnostics"
  ],
  "properties": {
    "plan": {
      "type": "string"
    },
    "survey": {
      "type": "string"
    },
    "staged": {
      "type": [
        "string",
        "null"
      ]
    },
    "surveyed": {
      "type": "integer",
      "minimum": 0
    },
    "planned": {
      "type": "integer",
      "minimum": 0
    },
    "promoted": {
      "type": "boolean"
    },
    "moved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clear": {
      "type": "boolean"
    },
    "covered": {
      "type": "boolean"
    },
    "unaccounted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "withoutDisposition": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknownDisposition": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "wrote"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "wrote": {
            "type": "string"
          }
        }
      }
    },
    "withoutReason": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unsurveyed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceless": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "withoutDestination": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unreadableDerivations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "wrote"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "wrote": {
            "type": "string"
          }
        }
      }
    },
    "collisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "destination",
          "identifier",
          "sources"
        ],
        "properties": {
          "destination": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "heading"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "heading": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "stagingFaults": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documents": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
