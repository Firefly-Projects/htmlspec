{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://html-spec.dev/schema/payload/1/run.schema.json",
  "title": "htmlspec run --json",
  "description": "The payload `htmlspec run --json` (`post run`) writes, in one of three shapes: the run it started with --as, what every run recorded with --check, and the preflight report --as writes in place of a run when the machine falls short. A later 1.x release can add a property to any object in this payload, and only a major release removes, renames, or retypes one, so a consumer ignores a property it does not know.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "runbook",
        "record",
        "path",
        "steps",
        "recording",
        "version",
        "preflight"
      ],
      "properties": {
        "runbook": {
          "type": "string"
        },
        "record": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "recording": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "string"
        },
        "preflight": {
          "type": "object",
          "required": [
            "checked",
            "passed"
          ],
          "properties": {
            "checked": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "runbook",
        "required",
        "unreadable",
        "runs",
        "diagnostics"
      ],
      "properties": {
        "runbook": {
          "type": "string"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unreadable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "record",
              "recorded"
            ],
            "properties": {
              "record": {
                "type": "string"
              },
              "recorded": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/diagnostic"
          }
        }
      }
    },
    {
      "$ref": "#/definitions/preflightReport"
    }
  ],
  "definitions": {
    "diagnostic": {
      "description": "One diagnostic, as htmlspec_validate::StructuredDiagnostic writes it. The four optional fields are present only where the rule supplies them.",
      "type": "object",
      "required": [
        "rule",
        "namespace",
        "severity",
        "message"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        },
        "unitId": {
          "type": "string"
        },
        "schemaPath": {
          "type": "string"
        },
        "projectionRule": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "preflightReport": {
      "description": "The preflight report `run --as` writes in place of a run, when this machine does not satisfy every prerequisite the runbook declares and no record was created. It is the payload `htmlspec preflight --json` writes, with the same fields.",
      "type": "object",
      "required": [
        "runbook",
        "version",
        "source",
        "workdir",
        "ready",
        "declared",
        "checks"
      ],
      "properties": {
        "runbook": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "workdir": {
          "type": "string"
        },
        "ready": {
          "type": "boolean"
        },
        "declared": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "requirement",
              "expected",
              "observed",
              "outcome",
              "remedy"
            ],
            "properties": {
              "requirement": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "passed",
                  "unmet",
                  "unavailable",
                  "timed-out",
                  "probe-failed"
                ]
              },
              "remedy": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "runbookRemedy": {
                "description": "What the runbook says to do when this check does not pass: one line of text from a preflight/v2 or preflight/v3 declaration, present whenever the declaration carries one, whatever the outcome. It is the runbook's words, never run.",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "run": {
                "description": "Present on a run check, a preflight/v3 declaration of kind run: the runbook it names, the lowest release it accepts where it declares one, the state of the check, the first satisfying records in name order with how many satisfy it in all, why each record does not count where none does, and the runs of the named runbook still under way. Names are the raw text. The state is unavailable where nothing was measured.",
                "type": "object",
                "required": [
                  "runbook",
                  "state",
                  "satisfiedBy",
                  "satisfying",
                  "notSatisfying",
                  "openRuns"
                ],
                "properties": {
                  "runbook": {
                    "type": "string"
                  },
                  "atLeast": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "met",
                      "unmet",
                      "missing",
                      "unavailable"
                    ]
                  },
                  "satisfiedBy": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string"
                    }
                  },
                  "satisfying": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "notSatisfying": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "record",
                        "reason"
                      ],
                      "properties": {
                        "record": {
                          "type": "string"
                        },
                        "reason": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "openRuns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
