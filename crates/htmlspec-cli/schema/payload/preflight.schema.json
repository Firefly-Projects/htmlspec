{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://html-spec.dev/schema/payload/1/preflight.schema.json",
  "title": "htmlspec preflight --json",
  "description": "The payload `htmlspec preflight <runbook> --json` (`get preflight`) writes: whether the runbook can start here, and every check it declares in document order. A later 1.x release can add a property to any object in this payload, and only a major release removes, renames, or retypes one, so a consumer ignores a property it does not know.",
  "type": "object",
  "required": [
    "runbook",
    "version",
    "source",
    "workdir",
    "ready",
    "declared",
    "checks"
  ],
  "properties": {
    "runbook": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "workdir": {
      "type": "string"
    },
    "ready": {
      "type": "boolean"
    },
    "declared": {
      "type": "integer",
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "expected",
          "observed",
          "outcome",
          "remedy"
        ],
        "properties": {
          "requirement": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "unmet",
              "unavailable",
              "timed-out",
              "probe-failed"
            ]
          },
          "remedy": {
            "type": [
              "string",
              "null"
            ]
          },
          "runbookRemedy": {
            "description": "What the runbook says to do when this check does not pass: one line of text from a preflight/v2 declaration, present whenever the declaration carries one, whatever the outcome. It is the runbook's words, never run.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
