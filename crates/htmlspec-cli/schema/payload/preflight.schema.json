{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://html-spec.dev/schema/payload/1/preflight.schema.json",
  "title": "htmlspec preflight --json",
  "description": "The payload `htmlspec preflight <runbook> --json` (`get preflight`) writes: whether the runbook can start here, and every check it declares in document order. A later 1.x release can add a property to any object in this payload, and only a major release removes, renames, or retypes one, so a consumer ignores a property it does not know.",
  "type": "object",
  "required": [
    "runbook",
    "version",
    "source",
    "workdir",
    "ready",
    "declared",
    "checks"
  ],
  "properties": {
    "runbook": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "workdir": {
      "type": "string"
    },
    "ready": {
      "type": "boolean"
    },
    "declared": {
      "type": "integer",
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "expected",
          "observed",
          "outcome",
          "remedy"
        ],
        "properties": {
          "requirement": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "unmet",
              "unavailable",
              "timed-out",
              "probe-failed"
            ]
          },
          "remedy": {
            "type": [
              "string",
              "null"
            ]
          },
          "runbookRemedy": {
            "description": "What the runbook says to do when this check does not pass: one line of text from a preflight/v2 or preflight/v3 declaration, present whenever the declaration carries one, whatever the outcome. It is the runbook's words, never run.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "run": {
            "description": "Present on a run check, a preflight/v3 declaration of kind run: the runbook it names, the lowest release it accepts where it declares one, the state of the check, the first satisfying records in name order with how many satisfy it in all, why each record does not count where none does, and the runs of the named runbook still under way. Names are the raw text. The state is unavailable where nothing was measured.",
            "type": "object",
            "required": [
              "runbook",
              "state",
              "satisfiedBy",
              "satisfying",
              "notSatisfying",
              "openRuns"
            ],
            "properties": {
              "runbook": {
                "type": "string"
              },
              "atLeast": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "met",
                  "unmet",
                  "missing",
                  "unavailable"
                ]
              },
              "satisfiedBy": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "string"
                }
              },
              "satisfying": {
                "type": "integer",
                "minimum": 0
              },
              "notSatisfying": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "record",
                    "reason"
                  ],
                  "properties": {
                    "record": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              },
              "openRuns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
