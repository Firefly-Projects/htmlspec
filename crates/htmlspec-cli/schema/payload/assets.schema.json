{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://html-spec.dev/schema/payload/1/assets.schema.json",
  "title": "htmlspec assets --json",
  "description": "The payload `htmlspec assets --json` (`get assets`) writes. A directory holding no asset store has nothing to check, and the operation writes no payload for it. A later 1.x release can add a property to any object in this payload, and only a major release removes, renames, or retypes one, so a consumer ignores a property it does not know.",
  "type": "object",
  "required": [
    "accepted",
    "storedAssets",
    "stores",
    "projectStores",
    "otherStores",
    "diagnostics"
  ],
  "properties": {
    "accepted": {
      "type": "boolean"
    },
    "storedAssets": {
      "type": "integer",
      "minimum": 0
    },
    "stores": {
      "type": "integer",
      "minimum": 0
    },
    "projectStores": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "otherStores": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    }
  },
  "definitions": {
    "diagnostic": {
      "description": "One diagnostic, as htmlspec_validate::StructuredDiagnostic writes it. The four optional fields are present only where the rule supplies them.",
      "type": "object",
      "required": [
        "rule",
        "namespace",
        "severity",
        "message"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        },
        "unitId": {
          "type": "string"
        },
        "schemaPath": {
          "type": "string"
        },
        "projectionRule": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
