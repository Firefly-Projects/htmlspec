/target
result
result-*

# Bytecode Python writes beside a module the scripts import. The development shell's python3 writes
# it there, and macOS's own interpreter writes it to a cache of its own, so nothing here met it until
# the shell supplied python3.
__pycache__/

# Generated explainer pages at the repository root. Each is several megabytes of
# rendered output, reproducible from its source, and not part of the contract.
# README.html is the project's own document and stays tracked.
/*.html
!/README.html
